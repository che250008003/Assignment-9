#include <iostream>
using namespace std;

struct Item {
    int id;      
    float cost;  
};

int main() {
    Item items[6] = {
        {101, 45.50},  
        {102, 120.75}, 
        {103, 30.20},  
        {104, 75.60},  
        {105, 15.99},  
        {106, 55.30}   
    };

    for (int i = 0; i < 6; i++) {
        if (items[i].cost > 50.00) {
            cout << "Item ID: " << items[i].id 
                 << ", Cost: $" << items[i].cost << endl;
        }
    }

    return 0;
}


